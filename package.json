{
  "name": "@semanticintent/semantic-chirp-intelligence-mcp",
  "version": "3.2.0",
  "description": "Semantic Intent pattern implementation for fantasy hockey intelligence - AI analysis that chirps you into championships",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "dev": "node --watch build/index.js",
    "start": "node build/index.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "verify:yahoo": "npm run build && node scripts/verify-yahoo.mjs",
    "preflight": "npm run build && node scripts/preflight.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "keywords": [
    "mcp",
    "semantic-intent",
    "fantasy-hockey",
    "chirp",
    "intelligence",
    "yahoo-fantasy",
    "ice"
  ],
  "author": "semanticintent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/semanticintent/semantic-chirp-intelligence-mcp.git"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/xml2js": "^0.4.14",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.19.1",
    "dotenv": "^17.4.2",
    "selfsigned": "^5.5.0",
    "xml2js": "^0.6.2"
  }
}
