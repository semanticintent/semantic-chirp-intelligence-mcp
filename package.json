{
  "name": "@semanticintent/semantic-chirp-intelligence-mcp",
  "version": "3.0.0",
  "description": "Semantic Intent pattern implementation for fantasy hockey intelligence - AI analysis that chirps you into championships",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "dev": "node --watch build/index.js",
    "start": "node build/index.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "semantic-intent",
    "fantasy-hockey",
    "chirp",
    "intelligence",
    "yahoo-fantasy",
    "ice"
  ],
  "author": "semanticintent",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semanticintent/semantic-chirp-intelligence-mcp.git"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/xml2js": "^0.4.14",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.19.1",
    "dotenv": "^17.4.2",
    "selfsigned": "^3.0.1",
    "xml2js": "^0.6.2"
  }
}
