{
  "name": "@semanticintent/semantic-chirp-intelligence-mcp",
  "version": "4.2.0",
  "description": "Universal fantasy hockey intelligence — a Model Context Protocol server that reads NHL schedule and player data and analyses any roster you paste. No account, no API key, no platform lock-in.",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "build": "npm run clean && tsc",
    "watch": "tsc --watch",
    "dev": "node --watch build/index.js",
    "start": "node build/index.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "preflight": "npm run build && node scripts/preflight.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "clean": "rm -rf build",
    "prepublishOnly": "npm run build && npm test",
    "serve:http": "node build/http.js",
    "dev:http": "npm run build && node build/http.js"
  },
  "keywords": [
    "mcp",
    "semantic-intent",
    "fantasy-hockey",
    "nhl",
    "chirp",
    "intelligence",
    "ice",
    "model-context-protocol"
  ],
  "author": "semanticintent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/semanticintent/semantic-chirp-intelligence-mcp.git"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
