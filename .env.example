# Get these from https://developer.yahoo.com/apps/create/
YAHOO_CLIENT_ID=your_client_id_here
YAHOO_CLIENT_SECRET=your_client_secret_here

# Your league and team IDs, from your team URL:
# https://hockey.fantasysports.yahoo.com/hockey/{LEAGUE_ID}/{TEAM_ID}
YAHOO_LEAGUE_ID=your_league_id_here
YAHOO_TEAM_ID=your_team_id_here

# Optional. OAuth scope requested during authentication.
#
# Leave this UNSET (the default). Yahoo then applies whatever permissions the
# app is registered with, which is what works. Sending an explicit scope that
# does not exactly match the app's registration is rejected outright with
# `invalid_scope`, even on apps that authenticate fine without one.
#
# Only set this if you have a specific reason, e.g. fspt-r / fspt-w.
# YAHOO_OAUTH_SCOPE=
