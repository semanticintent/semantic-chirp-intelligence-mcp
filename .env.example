# Get these from https://developer.yahoo.com/apps/create/
YAHOO_CLIENT_ID=your_client_id_here
YAHOO_CLIENT_SECRET=your_client_secret_here

# Your league and team IDs, from your team URL:
# https://hockey.fantasysports.yahoo.com/hockey/{LEAGUE_ID}/{TEAM_ID}
YAHOO_LEAGUE_ID=your_league_id_here
YAHOO_TEAM_ID=your_team_id_here

# Optional. OAuth scope requested during authentication.
#   fspt-r  Fantasy Sports read  (default — this server only issues GET requests)
#   fspt-w  Fantasy Sports read/write
# Set this to fspt-w only if your Yahoo app is registered with Read/Write
# permission; a scope that does not match the app's permission yields a token
# that 403s on every Fantasy endpoint.
# YAHOO_OAUTH_SCOPE=fspt-r
