{
  // chirp-edge: the analyst on Workers for the telestrator (see src/edge.ts). Deploy with `npm run edge:deploy`.
  // The npm package and the MCP server are unaffected by this file; wrangler reads it, tsc ignores it.
  "name": "chirp-edge",
  "main": "src/edge.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    { "binding": "CACHE", "id": "c709cd50aa0340fb927a4ee935a090c9" }
  ],
  "ratelimits": [
    { "name": "READ_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    "CORS_ORIGIN": "*",
    "AUTH_MODE": "none"
  },
  "triggers": { "crons": ["17 */6 * * *"] },
  "observability": { "enabled": true }
}
