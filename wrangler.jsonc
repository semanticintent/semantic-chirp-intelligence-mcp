{
  // chirp-edge: the analyst on Workers for the telestrator (see src/edge.ts). Deploy with `npm run edge:deploy`.
  // The npm package and the MCP server are unaffected by this file; wrangler reads it, tsc ignores it.
  "name": "chirp-edge",
  "main": "src/edge.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // The analyst's public hostname (custom domain in the semanticintent.dev zone). workers.dev stays as a fallback.
  "routes": [{ "pattern": "chirp-mcp.semanticintent.dev", "custom_domain": true }],
  "kv_namespaces": [
    { "binding": "CACHE", "id": "c709cd50aa0340fb927a4ee935a090c9" }
  ],
  "ratelimits": [
    { "name": "READ_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    // Browser origins allowed to call /read. Add the *.chatgpt.site origin when the page is published there.
    "CORS_ORIGIN": "https://sepiola.semanticintent.dev,https://sepiola.pages.dev,http://localhost:5173,http://localhost:4173",
    "AUTH_MODE": "none"
  },
  "triggers": { "crons": ["17 */6 * * *"] },
  "observability": { "enabled": true }
}
